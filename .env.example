# Nusxa oling: cp .env.example .env  — va qiymatlarni o'zgartiring. .env faylini hech qachon git'ga qo'shmang.
APP_DOMAIN=surxan-paxta.uz
# Uzun tasodifiy qiymat: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
COOKIE_SECURE=1
ADMIN_USER=admin
# Bo'sh qoldirilsa tasodifiy parol yaratiladi va data/BIRINCHI_ADMIN_PAROLI.txt ga yoziladi
ADMIN_PASSWORD=
APP_TZ=Asia/Tashkent
BACKUP_KEEP_DAYS=30
MAX_UPLOAD_MB=25
# Telegram (BotFather'dan). Faqat serverda saqlanadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Faqat A-Z a-z 0-9 _ - belgilaridan iborat uzun tasodifiy qiymat
TELEGRAM_WEBHOOK_SECRET=

# --- Tashqi arxivlar (ixtiyoriy; bo'sh bo'lsa "ulanmagan" deb ko'rsatiladi) ---
# Yopiq Telegram kanal ID si (masalan -1001234567890); bot kanalga admin qilib qo'shilgan bo'lishi kerak
TELEGRAM_ARCHIVE_CHAT_ID=
# Faqat hisobot yuboriladigan kanal (kunlik hisobot + ogohlantirishlar). Bot kanalga admin qilinadi.
TELEGRAM_REPORT_CHAT_ID=
# Ixtiyoriy: hisobot uchun alohida bot tokeni (bo'sh bo'lsa asosiy bot ishlatiladi)
TELEGRAM_REPORT_BOT_TOKEN=
# Google Sheets: jadval ID si va xizmat akkaunti JSON fayli (data/ papkasida saqlang)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=/data/google-service-account.json
# Mustaqil zaxira: rclone remote (masalan b2:surxon-zaxira yoki gdrive:surxon-zaxira); sozlama fayli:
OFFSITE_RCLONE_REMOTE=
RCLONE_CONFIG=/data/rclone.conf
